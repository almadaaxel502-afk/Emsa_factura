<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="itec.emsa.emsa.view.controller.FacturasController"
            styleClass="root-pane">

    <!-- Barra superior -->
    <top>
        <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="10">
            <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>
            <Button text="← Volver" onAction="#onVolver" styleClass="btn-secondary"/>
            <Label text="EMSA  /  Facturas" styleClass="navbar-title"/>
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.55">

            <!-- Panel izquierdo: tabla -->
            <VBox spacing="8">
                <padding><Insets top="16" right="12" bottom="16" left="16"/></padding>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="campoBusqueda" promptText="Buscar por número o cliente..."
                               HBox.hgrow="ALWAYS"/>
                    <Button text="Buscar" onAction="#onBuscar" styleClass="btn-primary"/>
                </HBox>

                <TableView fx:id="tablaFacturas" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNumero"  text="Número"  prefWidth="100"/>
                        <TableColumn fx:id="colFecha"   text="Fecha"   prefWidth="100"/>
                        <TableColumn fx:id="colCliente" text="Cliente" prefWidth="180"/>
                        <TableColumn fx:id="colTotal"   text="Total"   prefWidth="100"/>
                    </columns>
                    <placeholder><Label text="No hay facturas registradas"/></placeholder>
                </TableView>

                <HBox spacing="8">
                    <Button text="Eliminar" onAction="#onEliminar" styleClass="btn-danger"/>
                </HBox>
            </VBox>

            <!-- Panel derecho: formulario -->
            <VBox spacing="14">
                <padding><Insets top="16" right="16" bottom="16" left="12"/></padding>

                <Label text="Datos de la factura" styleClass="form-title"/>

                <Label text="Número de factura"/>
                <TextField fx:id="campoNumero" promptText="Ej: F-0001"
                           styleClass="input-field"/>

                <Label text="Fecha"/>
                <DatePicker fx:id="campoFecha" maxWidth="Infinity"/>

                <Label text="Cliente"/>
                <ComboBox fx:id="comboCliente" maxWidth="Infinity"
                          promptText="Seleccioná un cliente"/>

                <Label fx:id="lblEstado" wrapText="true"/>

                <HBox spacing="8">
                    <Button text="Nuevo" onAction="#onNuevo" styleClass="btn-secondary"/>
                    <Button fx:id="btnGuardar" text="Guardar" onAction="#onGuardar"
                            styleClass="btn-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
            </VBox>

        </SplitPane>
    </center>
</BorderPane>
