<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="itec.emsa.emsa.view.controller.LoginController"
      alignment="CENTER"
      spacing="15"
      styleClass="login-container">

    <padding>
        <Insets top="40" right="50" bottom="40" left="50"/>
    </padding>

    <Label text="EMSA" styleClass="title-label"/>
    <Label text="Sistema de Facturación" styleClass="subtitle-label"/>

    <Label text="Usuario" styleClass="field-label"/>
    <TextField fx:id="usernameField"
               promptText="Ingresá tu usuario"
               styleClass="input-field"/>

    <Label text="Contraseña" styleClass="field-label"/>
    <PasswordField fx:id="passwordField"
                   promptText="Ingresá tu contraseña"
                   styleClass="input-field"/>

    <Label fx:id="errorLabel"
           styleClass="error-label"
           wrapText="true"/>

    <Button fx:id="loginButton"
            text="Ingresar"
            onAction="#handleLogin"
            styleClass="login-button"
            maxWidth="Infinity"/>

</VBox>
