<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" styleClass="app-bg" stylesheets="@emsa.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ar.com.itec1misiones.emsa.view.controller.ClienteViewController">

  <VBox spacing="14.0">
    <padding>
      <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <VBox spacing="2.0">
      <Label text="Gestión de clientes" styleClass="page-title"/>
      <Label text="Creá, buscá, editá y eliminá los clientes que pagan el servicio eléctrico."
             styleClass="page-subtitle"/>
    </VBox>

    <HBox spacing="14.0">

      <VBox styleClass="card" spacing="10.0" prefWidth="340.0">
        <Label text="DATOS DEL CLIENTE" styleClass="section-mark"/>
        <VBox spacing="4.0">
          <Label text="Nombre *" styleClass="field-label"/>
          <TextField fx:id="nombreField" promptText="Nombre"/>
        </VBox>
        <VBox spacing="4.0">
          <Label text="Apellido" styleClass="field-label"/>
          <TextField fx:id="apellidoField" promptText="Apellido"/>
        </VBox>
        <VBox spacing="4.0">
          <Label text="Identificación nacional (DNI/CUIT)" styleClass="field-label"/>
          <TextField fx:id="dniField" promptText="Ej: 20-12345678"/>
        </VBox>
        <VBox spacing="4.0">
          <Label text="Dirección" styleClass="field-label"/>
          <TextField fx:id="direccionField" promptText="Calle y número"/>
        </VBox>
        <VBox spacing="4.0">
          <Label text="Tipo de IVA" styleClass="field-label"/>
          <ComboBox fx:id="tipoIVACombo" maxWidth="Infinity" promptText="Seleccionar..."/>
        </VBox>
        <HBox spacing="10.0">
          <Button text="Nuevo" onAction="#onNuevo" styleClass="button-ghost" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
          <Button text="Guardar" onAction="#onGuardar" styleClass="button-accent" HBox.hgrow="ALWAYS" maxWidth="Infinity" defaultButton="true"/>
        </HBox>
        <Button text="Eliminar cliente" onAction="#onEliminar" styleClass="button-danger" maxWidth="Infinity"/>
        <Label fx:id="mensajeLabel" wrapText="true" styleClass="muted"/>
      </VBox>

      <VBox styleClass="card" spacing="10.0" HBox.hgrow="ALWAYS">
        <HBox spacing="8.0" alignment="CENTER_LEFT">
          <Label text="CLIENTES REGISTRADOS" styleClass="section-mark"/>
          <Region HBox.hgrow="ALWAYS"/>
          <TextField fx:id="buscarField" promptText="Buscar por nombre, apellido o DNI..." prefWidth="230.0"/>
          <Button text="Buscar" onAction="#onBuscar" styleClass="button-primary"/>
          <Button text="Limpiar" onAction="#onLimpiarBusqueda" styleClass="button-ghost"/>
        </HBox>
        <TableView fx:id="clientesTable" VBox.vgrow="ALWAYS" prefHeight="420.0">
          <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60.0"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150.0"/>
            <TableColumn fx:id="colApellido" text="Apellido" prefWidth="150.0"/>
            <TableColumn fx:id="colDni" text="Identificación" prefWidth="130.0"/>
            <TableColumn fx:id="colDireccion" text="Dirección" prefWidth="180.0"/>
            <TableColumn fx:id="colIva" text="Tipo IVA" prefWidth="140.0"/>
          </columns>
        </TableView>
      </VBox>

    </HBox>

  </VBox>
</ScrollPane>
